{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ardas-social-kitchen",
  "account_id": "c0bdb071b67899c6590000ba154912e9",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-24",
  "vars": {
    "NDA_ENABLED": "true"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "ardas.evaakselrad.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
